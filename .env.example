# Copy this file to .env and fill in your key.

# Hosted LLM: get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is the cheapest; claude-sonnet-5-5 or claude-opus-5-5 give stronger design work.
CLAUDE_MODEL=claude-haiku-5-5

# Local image model.
#   flux2-klein-4b  Apache 2.0, no login needed, about 24 GB download on first run (default)
#   flux2-klein-9b  larger and sharper; non-commercial licence; accept it on Hugging Face,
#                   then run `uv run hf auth login` before first use
#   fal-ai/flux-2/klein/4b  the same 4b model hosted on fal.ai: about 2 seconds a render, half a
#                   cent per megapixel, no download. Needs FAL_KEY, and prompts are sent to fal.ai.
#                   It only draws from text, so set EDIT_MODEL as well.
IMAGE_MODEL=flux2-klein-4b
IMAGE_QUANTIZE=8        # 8, 6, 5, 4 or 3 bits; 0 = full precision
IMAGE_STEPS=4
IMAGE_WIDTH=768
IMAGE_HEIGHT=1024

# Optional second model used only when editing a photo or an earlier render.
#   fal-ai/qwen-image-edit-2511  hosted on fal.ai: fast, about 3 cents per megapixel. Needs
#                                FAL_KEY (https://fal.ai), and the image being edited is sent there.
#   qwen-image-edit-2511         the same model run locally: free, but about 58 GB to download
#                                and very slow on a 36 GB Mac
#   (blank)                      the image model above handles edits too
EDIT_MODEL=
FAL_KEY=
EDIT_QUANTIZE=6
EDIT_STEPS=8

# RENDERER=mock draws placeholder cards instead of running a model (no download).
RENDERER=mflux

PORT=8000


